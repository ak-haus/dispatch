{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["react", "react-dom", "vite/client"]
  },
  // The rail's own config rides the check too — it was the one authored file
  // in this app that no committed tsconfig covered (F31).
  "include": [".storybook/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "storybook-static"]
}
