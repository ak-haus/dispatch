{
  "name": "microsite-astro",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Prime DISpatch — Astro 6 editorial surface. Launch build (vellum substrate, dispatch-red, 5-typeface system, content-collection-driven articles).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate-commits.mjs && node scripts/generate-wire-snapshot.mjs && astro dev",
    "build": "node scripts/generate-commits.mjs && node scripts/generate-wire-snapshot.mjs && astro build",
    "preview": "astro preview",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "lighthouse": "lhci autorun",
    "smoke:prod": "playwright test --config playwright.prod.config.ts",
    "astro": "astro",
    "e2e:build": "PUBLIC_WIRE_FEED_URL=https://wire-ledger.test/feed.json astro build",
    "test:e2e": "pnpm e2e:build && playwright test",
    "check:archive-coverage": "node scripts/check-archive-coverage.mjs",
    "commits:generate": "node scripts/generate-commits.mjs",
    "wire:snapshot": "node scripts/generate-wire-snapshot.mjs",
    "cartography:segment": "node scripts/segment-cartography.mjs",
    "cartography:segment:sam": "doppler run --project prime-city --config dev -- node scripts/segment-sam.mjs",
    "cartography:depth": "doppler run --project prime-city --config dev -- node scripts/depth-cartography.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@observablehq/plot": "^0.6.17",
    "@prime-dispatch/ui": "workspace:*",
    "@react-spring/web": "^10.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "diff2html": "^3.4.56",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.43.0",
    "photoswipe": "^5.4.4",
    "posthog-js": "^1.418.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scrollama": "^3.2.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/playwright": "^0.14.12",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "chromatic": "^18.5.0",
    "happy-dom": "^20.11.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "replicate": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
