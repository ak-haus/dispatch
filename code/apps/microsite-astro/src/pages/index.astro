---
import fs from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'
import StackLayout from '@/layouts/StackLayout.astro'
import { EditorialDistrictMapHero } from '@/components/EditorialDistrictMapHero'
import type { StoryArticle } from '@/components/StoryCardCluster'

// Fetch published dispatches, sorted newest first.
const entries = await getCollection('dispatch')
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

// Pre-format date server-side so the React island receives a plain string.
// Date formatting belongs on the server; the island doesn't need the Date object.
const formatDate = (d: Date) =>
	new Intl.DateTimeFormat('en-CA', {
		year: 'numeric',
		month: '2-digit',
		day: '2-digit',
		timeZone: 'UTC',
	}).format(d)

const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN ?? ''

// Build-time issue date for the hero masthead strip. Baked into the static
// HTML so server and client agree at hydration; the hero island refreshes it
// to the live date after mount (see EditorialDistrictMapHero).
const heroDateLabel = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
}).format(new Date())

// Probe for a commissioned district-scale cartographic illustration.
// If public/cartography/district.{webp,jpg,png} exists, it's used as the base
// layer; the procedural SVG overlay composes on top. Falls back to pure SVG.
const cartographyDir = path.join(process.cwd(), 'public', 'cartography')
// Order matters: SVG checked first (best fidelity if AI-vectorized result is
// available), then webp/jpg/png in preference order. The first match wins.
const districtImageName = ['district.svg', 'district.webp', 'district.jpg', 'district.png'].find(
	(f) => {
		try { return fs.existsSync(path.join(cartographyDir, f)) } catch { return false }
	},
)
const districtImage = districtImageName ? `/cartography/${districtImageName}` : undefined

// Depth map probe — generated by `pnpm cartography:depth`.
// When present, CartographyCanvas adds a parallax layer over the illustration.
const depthFileName = fs.existsSync(path.join(cartographyDir, 'district.depth.png'))
	? 'district.depth.png'
	: undefined
const depthImage = depthFileName ? `/cartography/${depthFileName}` : undefined

// Aspect ratio of the cartographic illustration (width / height). Drives the
// page container so the image fills the entire scrollable area edge-to-edge.
// Adjust this value if you swap to an image with a different natural aspect.
//   0.753 = current district.webp (928×1232, ~3:4 portrait)
//   1.0   = square
//   1.33  = 4:3 landscape
//   0.428 = procedural map ratio (1200/2800, very tall)
const districtImageAspect = districtImage ? 0.753 : undefined

const articles: StoryArticle[] = entries.map((entry) => ({
	id: entry.id,
	href: `/dispatch/${entry.id}`,
	data: {
		title: entry.data.title,
		kicker: entry.data.kicker,
		dek: entry.data.dek,
		readingTime: entry.data.readingTime,
		dateLabel: formatDate(entry.data.date),
		provenance: { lane: entry.data.provenance.lane },
		author: {
			name: entry.data.author.name,
			role: entry.data.author.role,
			handle: entry.data.author.handle,
		},
		crossfire: entry.data.crossfire,
	},
}))

// Crossfire feature article: the newest dispatch with a crossfire block.
// Decouples from the cover-featured dispatch so a draft (no crossfire yet)
// doesn't hide the deck — Crossfire keeps showing the last fully-distributed
// story until a newer one declares its surfaces.
const crossfireArticle: StoryArticle | undefined = articles.find(
	(a) => (a.data.crossfire?.surfaces?.length ?? 0) > 0,
)
---

<!--
	DISpatch homepage.

	The map IS the page. EditorialDistrictMapHero renders a single tall
	cartographic surface (1200×2800 map coords → ~3.7 viewport heights of
	scrollable city) with:
	  - top masthead bar (issue meta)
	  - staggered wordmark reveal (DIS, then patch)
	  - DISpatch building cluster anchored near the bottom of initial viewport
	  - featured dispatch callout next to the building cluster
	  - district labels at map percentages (Editorial / Industrial / Bayou / Outskirts)
	  - dispatch index in the section below the map

	fullbleed:true removes <main>'s max-w-5xl/px-6/py-16 constraints so the
	map renders edge-to-edge. hideHero hides StackLayout's default kicker/h1.
-->
<StackLayout
	title="DISpatch"
	kicker="Editorial District · Prime City"
	description="A dev-diary magazine — the first Building in Prime City's Editorial District. Construction dispatches from inside the work."
	theme="vellum"
	hideHero={true}
	fullbleed={true}
>
	<EditorialDistrictMapHero
		client:load
		articles={articles}
		crossfireArticle={crossfireArticle}
		dispatchCount={entries.length}
		initialDateLabel={heroDateLabel}
		mapboxToken={mapboxToken}
		backgroundImage={districtImage}
		depthImage={depthImage}
		imageAspect={districtImageAspect}
	/>
</StackLayout>
