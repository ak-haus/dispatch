---
import pkg from '../../package.json'
import { Button } from '@/components/ui/button'

const stripCaret = (v: string) => v.replace(/^\^/, '')

const items = [
	{
		name: 'Astro',
		version: stripCaret(pkg.dependencies.astro),
		role: 'Framework · outer layer',
		note: 'Static-first site framework. Pages, layouts, routing, outer chrome.',
	},
	{
		name: 'Next.js',
		version: stripCaret(pkg.dependencies.next),
		role: 'Framework · dynamic layer',
		note: 'Reserved for React server components, API routes, dynamic sub-routes.',
	},
	{
		name: 'Tailwind CSS',
		version: stripCaret(pkg.dependencies.tailwindcss),
		role: 'Styling · utility layer',
		note: 'v4 via @tailwindcss/vite. CSS-first theme — no tailwind.config.js.',
	},
	{
		name: 'shadcn/ui',
		version: '4.7.0',
		role: 'Components · React layer',
		note: 'CLI-installed source-code components. Radix primitives. Edit in src/components/ui.',
	},
]
---

<section>
	<div class="mb-4 flex items-center justify-between">
		<p class="text-xs font-mono uppercase tracking-widest text-muted-foreground">Stack</p>
		<p class="text-xs font-mono text-muted-foreground">4 layers</p>
	</div>

	<div class="overflow-hidden rounded-lg border border-border">
		{
			items.map((item, i) => (
				<div
					class:list={[
						'grid grid-cols-12 gap-4 bg-card px-6 py-5',
						i !== items.length - 1 && 'border-b border-border',
					]}
				>
					<div class="col-span-3 flex items-baseline gap-2">
						<span class="text-base font-semibold tracking-tight">{item.name}</span>
						<span class="text-xs font-mono text-muted-foreground">v{item.version}</span>
					</div>
					<div class="col-span-3">
						<span class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
							{item.role}
						</span>
					</div>
					<div class="col-span-6 text-sm text-muted-foreground">{item.note}</div>
				</div>
			))
		}
	</div>

	<div class="mt-6 flex items-center justify-between">
		<p class="text-xs font-mono uppercase tracking-widest text-muted-foreground">
			Live React island — &lt;Button /&gt; (shadcn)
		</p>
	</div>
	<div class="mt-3 flex flex-wrap gap-2">
		<Button client:load size="sm">Default</Button>
		<Button client:load size="sm" variant="secondary">Secondary</Button>
		<Button client:load size="sm" variant="outline">Outline</Button>
		<Button client:load size="sm" variant="ghost">Ghost</Button>
	</div>
</section>
