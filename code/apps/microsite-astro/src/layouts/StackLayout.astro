---
import '@/styles/global.css'
import { Masthead } from '@/components/Masthead'
import { buildSearchIndex } from '@/lib/search-index'

interface Props {
	title: string
	kicker: string
	description: string
	theme?: 'neutral' | 'vellum'
	hideHero?: boolean
	/** fullbleed — full-viewport layout (homepage cover). Removes <main>
	 *  max-width/padding AND adds `dispatch-hero` body class so the masthead
	 *  starts hidden until first scroll. Use ONLY when the page wants the
	 *  cover-style hero animation behavior. */
	fullbleed?: boolean
	/** fullWidthMain — removes <main> max-width/padding so children render
	 *  edge-to-edge, but keeps the masthead visible. Use for layouts that
	 *  want hero sections to span the viewport (article pages) without
	 *  inheriting homepage-only behaviors. */
	fullWidthMain?: boolean
	/** noindex — keeps a surface out of search results. For the /preview/*
	 *  proving grounds, which are internal QA + design-system reference and
	 *  were never part of the public IA. Pairs with the sitemap filter in
	 *  astro.config.mjs: the meta tag governs crawlers that arrive by link,
	 *  the filter stops us advertising the route in the first place. */
	noindex?: boolean
}

const {
	title,
	kicker,
	description,
	theme = 'neutral',
	hideHero = false,
	fullbleed = false,
	fullWidthMain = false,
	noindex = false,
} = Astro.props
const unconstrained = fullbleed || fullWidthMain

const isVellum = theme === 'vellum'
const currentPath = Astro.url.pathname

// Per AK 2026-05-14: every surface gets the full nav (reception variant).
// The compressed 'article' variant has been retired — sub-page surfaces use
// the BackToDispatch pill at the top of the page body instead.
const navVariant: 'reception' | 'article' = 'reception'

// Server-rendered search index per SearchPalette spec.md §10. Built at
// Astro page-render time from the dispatch content collection; passed as
// a prop to the Masthead React island so the SearchPalette can query
// without runtime fetches.
const searchIndex = await buildSearchIndex()
---

<!doctype html>
<html lang="en" data-prime-cycle="dawn">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — DISpatch</title>
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!--
			Critical-weight font preloads (canon typography/css/preload.html):
			Body Regular + Title Regular + Nav + Wordmark are first-paint
			critical; every other cut loads on demand via font-display: swap.
			crossorigin is required for same-origin font preload semantics.
			Wordmark/nav are the PP premium files on the flat /fonts/ rail;
			the OFL cuts live under /fonts/<surface>/ (OQ-2 self-host wiring).
		-->
		<link rel="preload" href="/fonts/body/crimson-pro-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/title/vollkorn-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/PPPangramSans-Extrabold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href="/fonts/PPEditorialNew-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

		<!--
			Theme-cycler FOUC prevention.

			Reads the persisted cycle from localStorage and applies the
			data-prime-cycle attribute SYNCHRONOUSLY before <body> renders.
			Without this, the page paints in Dawn first then flashes to the
			persisted cycle on hydration.

			Three cycles: dawn (default) | dusk (twilight) | night (dark).
			.dark class is mirrored for legacy shadcn compatibility on the
			sitemap surface.
		-->
		<script is:inline>
			;(() => {
				try {
					const cycle = localStorage.getItem('prime-cycle')
					if (cycle === 'dusk' || cycle === 'night') {
						document.documentElement.setAttribute('data-prime-cycle', cycle)
						if (cycle === 'night') document.documentElement.classList.add('dark')
					}
				} catch (_) {
					/* localStorage unavailable (private mode); fall through to default Dawn */
				}
			})()
		</script>

		<!--
			Error tracking (Golden Board A6, error-tracking half; vendor + DSN
			decided at U6 — Sentry, free tier, org prime-city).

			Sits BEFORE the analytics boot on purpose: this script only attaches
			two listeners, and attaching them earlier widens the window in which a
			hydration failure is caught. It does NOT load the Sentry SDK — the
			vendor chunk is fetched the first time an error actually fires, and the
			error that triggered it is buffered and reported on arrival. A healthy
			page view pays for the listeners and nothing else, which is what keeps
			the A4 byte + TBT ratchet whole.

			With no PUBLIC_SENTRY_DSN the boot returns before attaching anything,
			so this can sit in the layout ahead of the env var being set — the same
			arms-on-token posture as the analytics lane next door. What may and may
			not be collected is asserted in src/lib/observability/posture.test.ts.
		-->
		<script>
			import { bootErrorTracking } from '@/lib/observability/boot'
			bootErrorTracking()
		</script>

		<!--
			Editorial analytics (ADR-0003 §Stage 6, register §9: PostHog EU
			Cloud, cookieless, no consent banner, replay off).

			A module script, not `is:inline`: it must be bundled so the guard on
			PUBLIC_POSTHOG_KEY resolves at build time. With no key the boot
			returns before its dynamic import, so no request is made and no
			listener is attached — which is why this can sit in the layout
			before AK's one-time signup. Precisely: rollup still EMITS the
			posthog-js chunk into dist/ (~247KB), but nothing preloads it and
			the guard means the browser never fetches it. Armed, it is a lazy
			fetch after first paint, never render-blocking.

			No consent banner is required BECAUSE of the posture, not in spite
			of it: cookieless server-hash mode stores nothing on the device and
			`person_profiles: 'never'` creates no profile. Weakening either one
			would change that answer — src/lib/analytics/posture.test.ts is what
			makes weakening it fail.
		-->
		<script>
			import { bootAnalytics } from '@/lib/analytics/boot'
			void bootAnalytics()
		</script>
	</head>
	<body
		class:list={[
			'flex min-h-screen flex-col antialiased',
			isVellum ? 'dispatch-surface' : 'bg-background text-foreground',
			fullbleed && 'dispatch-hero',
		]}
	>
		<Masthead
			client:load
			theme={theme}
			currentPath={currentPath}
			variant={navVariant}
			searchIndex={searchIndex}
		/>

		<main class:list={[
				'flex-1 w-full',
				!unconstrained && 'mx-auto max-w-5xl px-6 py-16',
			]}>
			{
				!hideHero && (
					<div class="space-y-3">
						<p
							class:list={[
								'text-xs uppercase tracking-widest',
								isVellum
									? 'font-nav text-body-muted'
									: 'font-mono text-muted-foreground',
							]}
						>
							{kicker}
						</p>
						<h1
							class:list={[
								'text-5xl tracking-tight',
								isVellum
									? 'font-narrative font-bold text-body-strong'
									: 'font-semibold',
							]}
						>
							{title}
						</h1>
						<p
							class:list={[
								'max-w-2xl text-lg',
								isVellum ? 'font-body text-body-muted' : 'text-muted-foreground',
							]}
						>
							{description}
						</p>
					</div>
				)
			}

			<slot />
		</main>

		<footer
			class:list={[
				'border-t',
				isVellum ? 'border-lane-institutional-strong/20' : 'border-border',
			]}
		>
			<div
				class:list={[
					'mx-auto max-w-5xl px-6 py-6 text-xs',
					isVellum ? 'font-mono text-body-faint' : 'font-mono text-muted-foreground',
				]}
			>
				DISpatch · A Prime City editorial publication · &copy; 2026
			</div>
		</footer>

		<!--
			Sitewide Lenis scroll orchestration.

			Treats scroll as a first-class storytelling system. Downstream
			components subscribe to window.__lenis for velocity-smoothed scroll.
			Reduced-motion users get native scroll. Anchor links intercepted
			for in-page smooth navigation.
		-->
		<script>
			import Lenis from 'lenis'

			const prefersReducedMotion = window.matchMedia(
				'(prefers-reduced-motion: reduce)'
			).matches

			if (!prefersReducedMotion) {
				const lenis = new Lenis({
					duration: 1.1,
					easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					smoothWheel: true,
					touchMultiplier: 1.5,
					wheelMultiplier: 1,
				})

				function raf(time: number) {
					lenis.raf(time)
					requestAnimationFrame(raf)
				}
				requestAnimationFrame(raf)

				document.addEventListener('click', (event) => {
					const target = event.target as HTMLElement | null
					const anchor = target?.closest('a[href^="#"]') as HTMLAnchorElement | null
					if (!anchor) return
					const href = anchor.getAttribute('href')
					if (!href || href === '#') return
					const id = href.slice(1)
					const dest = document.getElementById(id)
					if (!dest) return
					event.preventDefault()
					lenis.scrollTo(dest, { offset: -16 })
					history.pushState(null, '', href)
				})

				;(window as Window & { __lenis?: Lenis }).__lenis = lenis
			} else {
				document.documentElement.style.scrollBehavior = 'auto'
			}
		</script>
	</body>
</html>
