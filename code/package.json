{
  "name": "prime-dispatch-microsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Prime DISpatch — the Astro 7 editorial site, its Storybook, and the shared tokens and ui packages.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:astro": "pnpm --filter microsite-astro dev",
    "dev:storybook": "pnpm --filter storybook dev",
    "build": "pnpm -r build",
    "build:astro": "pnpm --fail-if-no-match --filter @prime-dispatch/tokens build && pnpm --fail-if-no-match --filter microsite-astro build",
    "build:tokens": "pnpm --fail-if-no-match --filter @prime-dispatch/tokens build",
    "build:storybook": "pnpm --filter storybook build",
    "typecheck": "pnpm -r --parallel typecheck",
    "clean": "pnpm -r --parallel clean"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "devalue": "^5.9.2",
      "postcss": "^8.5.10",
      "esbuild": "^0.25.0",
      "ws": "^8.20.1",
      "fast-uri": "^3.1.6",
      "svgo": "^4.1.0",
      "js-yaml@^4": "^4.3.2"
    }
  }
}
