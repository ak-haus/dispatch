{
  "name": "@prime-dispatch/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prime DISpatch component library — 20 V1 components per CD4 ratified inventory; consumed by apps/microsite-next, apps/microsite-astro, apps/storybook; future Buildings consume via shadcn/ui MCP registry.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./next-shell": {
      "types": "./src/next-shell.ts",
      "import": "./src/next-shell.ts"
    },
    "./f5": {
      "types": "./src/f5-primitives.ts",
      "import": "./src/f5-primitives.ts"
    },
    "./custom/*": {
      "types": "./src/components/custom/*/index.ts",
      "import": "./src/components/custom/*/index.ts"
    },
    "./patterns/*": {
      "types": "./src/components/patterns/*/index.ts",
      "import": "./src/components/patterns/*/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@formkit/auto-animate": "^0.8.4",
    "@hookform/resolvers": "^5.9.1",
    "@observablehq/plot": "^0.6.17",
    "@prime-dispatch/tokens": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-contour": "^4.0.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "react-hook-form": "^7.85.0",
    "scrollama": "^3.2.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
