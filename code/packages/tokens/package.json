{
  "name": "@prime-dispatch/tokens",
  "version": "1.0.0-s2",
  "private": true,
  "type": "module",
  "description": "Prime DISpatch design tokens — the S2 token engine (ADR-0003 §Stage 2): DTCG 2025.10 source in git, Style Dictionary v5 parse/merge, generated CSS variables + Tailwind v4 @theme emitted into microsite-astro and dist/. CI drift-gated.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
