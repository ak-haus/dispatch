      "import": "./src/index.ts"
    },
    "./css": "./dist/tokens.css",
    "./theme": "./dist/tokens.theme.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/validate-dtcg.mjs && node scripts/build.mjs",
    "validate": "node scripts/validate-dtcg.mjs",
    "test": "node --test \"__tests__/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "colorjs.io": "^0.5.2",
    "rimraf": "^6.1.3",
    "style-dictionary": "^5.5.1",
    "typescript": "^5.9.3"
  }
}
